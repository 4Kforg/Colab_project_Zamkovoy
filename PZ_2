        "#Дано трехзначное число. Используя одну операцию деления нацело,\n",
        "#вывести первую цифру данного числа (сотни)\n",
        "# Ввод трехзначного числа\n",
        "number = int(input(\"Введите трехзначное число: \"))\n",
        "\n",
        "# Вычисление первой цифры (сотен) с помощью деления нацело на 100\n",
        "first_digit = number // 100\n",
        "\n",
        "# Вывод результата\n",
        "print(f\"Первая цифра (сотни): {first_digit}\")\n"
